---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VennMark from '../components/VennMark.astro';
import { site } from '../data/site';

const news = (await getCollection('news')).sort(
  (a, b) => new Date(b.data.sortDate).getTime() - new Date(a.data.sortDate).getTime()
);
---
<BaseLayout title="Home">
  <section class="hero section">
    <div class="wrap hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">{site.role}</p>
        <h1 class="hero-title">{site.name}</h1>
        <p class="hero-tagline">{site.focus}</p>


        <div class="hero-intro">
          <p>
            I’m currently working as a Research Assistant at North South University,
            Dhaka, Bangladesh, under the supervision of
            <a
              href="https://sites.google.com/site/rshafin"
              target="_blank"
              rel="noopener noreferrer"
              class="supervisor-link"
            >Dr. Shafin Rahman</a>.
          </p>

          <p>
            My research focuses on three primary directions:
            <strong>(1) Hyperspectral Imaging</strong>, including spectral
            unmixing-aware classification, test-time adaptation under distribution
            shifts, and cross-domain few-shot learning;
            <strong>(2) Video Understanding</strong>, particularly online temporal
            action localization in egocentric procedural videos; and
            <strong>(3) Trustworthy Multimodal Learning</strong>, focusing on the
            evaluation and trustworthiness of Unified Multimodal Models (UMMs).
          </p>
        </div>

        <div class="hero-actions">
          <!-- <a class="btn btn-primary" href={site.cvUrl} target="_blank" rel="noopener noreferrer">View CV</a> -->
          <a class="btn btn-ghost" href="/contact/">Get in touch</a>
        </div>

        <div class="hero-social" aria-label="Social links">
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href={site.scholar} target="_blank" rel="noopener noreferrer">Scholar</a>
          <span aria-hidden="true">·</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>

      <!-- <div class="hero-visual reveal">
        <VennMark />
      </div> -->
      <div class="hero-visual reveal">
        <img
          src={site.avatar}
          alt={`${site.name} profile photo`}
          class="profile-photo"
        />
      </div>
    </div>
  </section>

  <section class="section bio-section">
    <div class="wrap bio-grid">
      <div class="reveal">
        <p class="eyebrow">About</p>
        <h2 class="section-title">Background</h2>
      </div>
      <div class="bio-copy reveal">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow reveal">Timeline</p>
      <h2 class="section-title reveal">Recent news</h2>
      <ul class="news-list">
        {news.map((item) => (
          <li class="news-item reveal">
            <span class="news-date">{item.data.date}</span>
            <span class="news-text">{item.data.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: 64px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(2.4rem, 1.9rem + 2.4vw, 3.6rem);
    margin-bottom: 10px;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 22px;
  }

  .hero-intro {
  max-width: 56ch;
  color: var(--text-muted);
  font-size: 1.05rem;
  text-align: justify;
  hyphens: auto;
  }


  .supervisor-link {
    color: #0d9488;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .supervisor-link:hover {
    color: #0f766e;
    text-decoration: underline;
  }

  .bio-copy p {
    text-align: justify;
    hyphens: auto;
  }



  .hero-actions {
    display: flex;
    gap: 14px;
    margin: 26px 0 24px;
    flex-wrap: wrap;
  }

  .hero-social {
    font-size: 0.88rem;
    color: var(--text-faint);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .hero-social a { color: var(--text-muted); }
  .hero-social a:hover { color: var(--accent); }

  .bio-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
  }
  .bio-copy p { color: var(--text-muted); }

  .news-list {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
  }
  .news-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
  }
  .news-item:last-child { border-bottom: 1px solid var(--border); }
  .news-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .news-text { color: var(--text-muted); }

  @media (max-width: 780px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; max-width: 220px; margin: 0 auto; }
    .bio-grid { grid-template-columns: 1fr; }
    .news-item { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
